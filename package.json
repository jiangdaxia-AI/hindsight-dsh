{
  "name": "hindsight-dsh",
  "version": "0.1.0",
  "description": "Hindsight long-term memory for DeepSeek Harness — a self-contained Cordis plugin with an in-app settings page (cloud, self-hosted, or a local daemon).",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "hindsight",
    "memory",
    "agent-memory"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "hindsight-dsh": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "exports": {
    ".": "./dist/host.js",
    "./dsh": "./dist/host.js",
    "./cli": "./dist/cli.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync-runtime": "node scripts/sync-runtime.mjs",
    "check-runtime": "node scripts/sync-runtime.mjs --check",
    "check-contract": "node scripts/check-contract.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.0",
    "@vectorize-io/hindsight-all": "^0.10.2",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.0",
    "smol-toml": "^1.8.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
